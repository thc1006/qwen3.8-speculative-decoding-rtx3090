+    // buffer by output row. Two of those buffers are token-row indexed - embd_nextn when
+    // embeddings_nextn_masked is off, and embd_layer_inp in every mode - so the permutation has
+    // to be gated. This case shows the ordering that triggers it.
+    t.test("interleaved_seqs_give_unsorted_out_ids", [&](testing & t) {
+        batch_builder bb;
+        bb.add(0, {0}, true);   // batch index 0
+        bb.add(0, {1}, true);   // batch index 1
+        bb.add(1, {0}, true);   // batch index 2
+        bb.add(1, {1}, true);   // batch index 3
+
+        llama_batch_allocr ba(1);
+        t.assert_true(ba.init(bb.make(), vocab, nullptr, bb.n_embd, 4, false));
+
+        llama_ubatch ub = ba.split_equal(8, false, 0);
+        t.assert_equal(4u, ub.n_tokens);
+
+        // split_equal groups tokens by sequence, so the outputs come back in the order
+        // s0(batch 0), s0(batch 2), s1(batch 1), s1(batch 3).
+        const auto & out_ids = ba.get_out_ids();
+        t.assert_equal((size_t) 4, out_ids.size());
+        t.assert_equal(0, out_ids[0]);
+        t.assert_equal(2, out_ids[1]);
+        t.assert_equal(1, out_ids[2]);
+        t.assert_equal(3, out_ids[3]);
+
+        bool sorted = true;
+        for (size_t i = 0; i < out_ids.size(); ++i) {
+            if (out_ids[i] != (int64_t) i) {
+                sorted = false;
+            }
+        }
+        t.assert_true(!sorted);
+    });
+
     t.test("split_equal_unequal_lengths", [&](testing & t) {
