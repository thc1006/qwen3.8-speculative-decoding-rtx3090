From fc62ba743b4089be2b6b0a8d244604ce07b3c626 Mon Sep 17 00:00:00 2001
From: thc1006 <84045975+thc1006@users.noreply.github.com>
Date: Tue, 25 Aug 2026 03:57:46 +0800
Subject: [PATCH] server : expose the speculative verification-step count per
 request

The server already tracks n_draft_verif_steps, but the corresponding
draft_n_verif_steps value is not included in the per-request timings JSON.

The existing draft_n and draft_n_accepted fields are enough to calculate the
draft acceptance rate, but not the mean acceptance length, because the latter
also needs the number of verification steps. The server already computes mean
acceptance length from 1 + n_draft_accepted / n_draft_verif_steps.

The Prometheus metric is useful for server-wide monitoring, but it is
cumulative. For request-level benchmarks, the value still needs to be available
in the request timings.

No new state is introduced; the patch only exposes a counter that is already
maintained by the server.

Signed-off-by: thc1006 <84045975+thc1006@users.noreply.github.com>
---
 tools/server/server-common.cpp              | 5 +++--
 tools/server/tests/unit/test_speculative.py | 6 +++++-
 2 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/tools/server/server-common.cpp b/tools/server/server-common.cpp
index 4f5b820..79980db 100644
--- a/tools/server/server-common.cpp
+++ b/tools/server/server-common.cpp
@@ -80,8 +80,9 @@ json server_slot_stats::to_json() const {
     };
 
     if (n_draft_tokens > 0) {
-        base["draft_n"]          = n_draft_tokens;
-        base["draft_n_accepted"] = n_draft_accepted;
+        base["draft_n"]             = n_draft_tokens;
+        base["draft_n_accepted"]    = n_draft_accepted;
+        base["draft_n_verif_steps"] = n_draft_verif_steps;
     }
 
     return base;
diff --git a/tools/server/tests/unit/test_speculative.py b/tools/server/tests/unit/test_speculative.py
index 5837195..4d94e7d 100644
--- a/tools/server/tests/unit/test_speculative.py
+++ b/tools/server/tests/unit/test_speculative.py
@@ -47,7 +47,11 @@ def test_with_and_without_draft():
     server.start()
     res = server.make_request("POST", "/completion", data=request)
     assert res.status_code == 200
-    assert res.body["timings"]["draft_n"] > 0
+    timings = res.body["timings"]
+    assert timings["draft_n"] > 0
+    assert timings["draft_n_accepted"] <= timings["draft_n"]
+    # mean acceptance length needs this, the other two only give the rate
+    assert timings["draft_n_verif_steps"] > 0
     tokens_draft = res.body["tokens"]
 
     assert tokens_no_draft == tokens_draft
